# =============================================================================
# RegimA Training System - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values

# =============================================================================
# Database Configuration
# =============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/regima_training

# =============================================================================
# Session Configuration
# =============================================================================
SESSION_SECRET=your-session-secret-here

# =============================================================================
# xAPI / Learning Record Store Configuration
# =============================================================================
# Enable xAPI tracking
XAPI_ENABLED=false

# LRS endpoint URL
XAPI_ENDPOINT=http://localhost:8080/xapi

# Authentication type: 'basic' or 'oauth'
XAPI_AUTH_TYPE=basic

# Basic auth credentials
XAPI_USERNAME=admin
XAPI_PASSWORD=password

# OAuth token (if using oauth auth type)
XAPI_TOKEN=

# Base URL for activity IDs
XAPI_ACTIVITY_BASE=https://regima.training/activities

# =============================================================================
# SCORM Configuration
# =============================================================================
# SCORM version: '1.2' or '2004'
SCORM_VERSION=2004

# Output directory for generated SCORM packages
SCORM_OUTPUT_DIR=/tmp/scorm-packages

# =============================================================================
# LTI 1.3 Configuration
# =============================================================================
# Enable LTI integration
LTI_ENABLED=false

# Tool target link URI (where LTI launches redirect to)
LTI_TARGET_LINK_URI=http://localhost:5000/lti/launch

# OIDC initiation URL
LTI_OIDC_URL=http://localhost:5000/lti/oidc

# JWKS endpoint URL
LTI_JWKS_URI=http://localhost:5000/lti/jwks

# =============================================================================
# Shopify Configuration
# =============================================================================
# Note: RegimA Zone UK owns and pays for the Shopify platforms.
# Configure these settings based on your specific Shopify store.

# Shopify store domain (e.g., your-store.myshopify.com)
SHOPIFY_SHOP_DOMAIN=

# Shopify Admin API access token
# Generate from: Shopify Admin > Apps > Develop apps
SHOPIFY_ACCESS_TOKEN=

# Shopify API version
SHOPIFY_API_VERSION=2024-01

# Webhook verification secret
SHOPIFY_WEBHOOK_SECRET=

# =============================================================================
# Application Configuration
# =============================================================================
# Node environment
NODE_ENV=development

# Server port
PORT=5000

# Base URL for the application
BASE_URL=http://localhost:5000

# =============================================================================
# Feature Flags
# =============================================================================
# Enable course sales through Shopify
ENABLE_COURSE_SALES=false

# Enable certificate generation
ENABLE_CERTIFICATES=true

# Enable quiz functionality
ENABLE_QUIZZES=true

# Enable progress tracking
ENABLE_PROGRESS_TRACKING=true
